# Dell's Bag & Co backend environment template
# Copy to .env for local development. Never commit real credentials.

PORT=8080
DB_TARGET=local

# Local XAMPP / MariaDB
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=dells_bag_co_db

# Online TiDB Cloud - configure these in Render Environment.
# Set DB_TARGET=tidb on Render. Do not put real values in this file.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=dells_bag_co_db

# Netlify frontend URL (set in Render; comma-separated URLs are supported)
FRONTEND_URL=

# Firebase Admin service account JSON (keep private; set locally / in Render)
FIREBASE_SERVICE_ACCOUNT_JSON=
